---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
    variant?: "sidebar" | "inline";
    class?: string;
}

const { headings, variant = "sidebar", class: className = "" } = Astro.props;
---

{
    variant === "sidebar" ? (
        <aside
            class:list={[
                "toc-sidebar sticky hidden h-fit w-64 shrink-0 space-y-3 rounded-2xl border border-white/5 bg-soft/60 p-5 shadow-soft xl:block",
                className,
            ]}
            style="top: calc(var(--header-offset-active, 8rem) + 2rem); transition: top 300ms ease;"
            aria-label="Table of contents"
        >
            <div class="flex items-center justify-between border-b border-white/5 pb-3">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                    On this page
                </h2>
                <span class="rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-gray-400">
                    {headings.length}
                </span>
            </div>
            <nav class="max-h-[calc(100vh-var(--header-offset-active,8rem)-8rem)] overflow-y-auto pr-1 text-sm">
                <ul class="space-y-1.5 border-l border-white/10 pl-3">
                    {headings.map((h) => (
                        <li class={h.depth === 3 ? "pl-3" : ""}>
                            <a
                                href={`#${h.slug}`}
                                data-toc-link={h.slug}
                                class:list={[
                                    "toc-link block py-1 text-xs transition-colors duration-150 leading-snug",
                                    h.depth === 2
                                        ? "toc-depth-2 font-medium text-gray-300 hover:text-accent"
                                        : "toc-depth-3 text-gray-400 hover:text-accent",
                                ]}
                            >
                                {h.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
    ) : (
        <details
            class:list={[
                "toc-mobile not-prose mb-8 rounded-2xl border border-white/10 bg-white/5 p-4 xl:hidden",
                className,
            ]}
            data-toc-mobile
        >
            <summary class="flex cursor-pointer items-center justify-between font-medium text-gray-300 hover:text-accent select-none list-none text-sm">
                <span class="flex items-center gap-2">
                    <svg
                        class="h-4 w-4 text-accent"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <line x1="8" y1="6" x2="21" y2="6" />
                        <line x1="8" y1="12" x2="21" y2="12" />
                        <line x1="8" y1="18" x2="21" y2="18" />
                        <line x1="3" y1="6" x2="3.01" y2="6" />
                        <line x1="3" y1="12" x2="3.01" y2="12" />
                        <line x1="3" y1="18" x2="3.01" y2="18" />
                    </svg>
                    <span>Table of Contents</span>
                </span>
                <svg
                    class="toc-chevron h-4 w-4 text-gray-400 transition-transform duration-200"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M5 8l5 5 5-5"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </summary>
            <nav class="mt-3 max-h-64 overflow-y-auto border-t border-white/5 pt-3">
                <ul class="space-y-2 text-sm">
                    {headings.map((h) => (
                        <li class={h.depth === 3 ? "pl-4 text-xs" : ""}>
                            <a
                                href={`#${h.slug}`}
                                data-toc-mobile-link
                                class="block text-gray-300 transition hover:text-accent"
                            >
                                {h.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </details>
    )
}
